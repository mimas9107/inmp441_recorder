# For SPIFFS partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size (adjust based on your ESP32)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# I2S pins (can be changed in menuconfig)
CONFIG_I2S_BCK_GPIO=26
CONFIG_I2S_WS_GPIO=25
CONFIG_I2S_DIN_GPIO=22

# Audio settings
CONFIG_SAMPLE_RATE=16000
CONFIG_RECORD_SECONDS=5
